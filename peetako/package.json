{
  "name": "peetako-phase-2",
  "version": "0.2.0",
  "private": true,
  "description": "Peetako — raise a square-faced gecko from Malaysian Borneo. Phase 2.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
